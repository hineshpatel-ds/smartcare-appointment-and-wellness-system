# Copy to backend.hcl (untracked - see .gitignore) and fill in real values,
# then run: terraform init -backend-config=backend.hcl
#
# The S3 bucket and DynamoDB lock table must already exist before running
# `terraform init` -- Terraform can't create the place it stores its own
# state. A minimal one-time bootstrap:
#   aws s3api create-bucket --bucket <bucket> --region <region>
#   aws s3api put-bucket-versioning --bucket <bucket> --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name <lock-table> \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST

bucket         = "saws-terraform-state"
key            = "smartcare/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "saws-terraform-locks"
