flowchart LR
  guest[Guest User]
  patient[Registered Patient]
  coordinator[Wellness Coordinator]

  subgraph GCP[Google Cloud Platform]
    ui[Cloud Run: React Frontend]
    api[Cloud Run: Node.js Express API]
    firestore[(Firestore Mirror)]
    pubsub[Pub/Sub: Support Concerns]
    dialogflow[Dialogflow Target Agent]
    nlp[Natural Language API]
  end

  subgraph AWS[Amazon Web Services]
    cognito[Cognito User Pool]
    users[(DynamoDB: Users)]
    appointments[(DynamoDB: Appointments)]
    services[(DynamoDB: Services)]
    messages[(DynamoDB: Support Messages)]
    feedback[(DynamoDB: Feedback)]
    logins[(DynamoDB: Login Stats)]
    sns[SNS Topic]
    sqs[SQS Queue]
    lambdas[AWS Lambda Handlers]
  end

  guest --> ui
  patient --> ui
  coordinator --> ui
  ui --> api

  api --> cognito
  api --> users
  api --> appointments
  api --> services
  api --> messages
  api --> feedback
  api --> logins
  api --> firestore
  api --> pubsub
  api --> nlp
  api --> sns
  api --> sqs
  sqs --> lambdas
  lambdas --> sns
  dialogflow -. fulfillment target .-> api

  classDef gcp fill:#e8f1ff,stroke:#3774d6,color:#123;
